# Normalise line endings. The repository is edited on Windows but executed on
# Linux (mkarchiso, chroots, GitHub runners), and a shell script with CRLF
# endings fails with '\r': command not found. Force LF on checkout for
# everything that runs on the machine; batch files are the only exception.
* text=auto eol=lf

*.bat         text eol=crlf

*.sh          text eol=lf
*.service     text eol=lf
*.conf        text eol=lf
*.preset      text eol=lf
*.rules       text eol=lf
*.json        text eol=lf
*.md          text eol=lf
*.yml         text eol=lf
*.ts          text eol=lf
*.mjs         text eol=lf
*.meta        text eol=lf
liteai-*      text eol=lf
.bash_profile text eol=lf
.bashrc       text eol=lf
*.bat         text eol=crlf
