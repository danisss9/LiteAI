#!/usr/bin/env bash
# Update the Arch base from the pi session without a password.
#
# Runs through pkexec, which polkit answers without a prompt for exactly this
# program (etc/polkit-1/rules.d/49-liteai.rules). It takes exactly one word -
# there is no way to smuggle a package name or an option through it.
#
# Usage: liteai-update update

set -Eeuo pipefail

readonly ACTION="${1:-}"

msg() { printf '==> %s\n' "$*"; }
die() { printf 'error: %s\n' "$*" >&2; exit 1; }

(( EUID == 0 )) || die "this must run as root (the LiteAI tools use pkexec)"

case "${ACTION}" in
    update)
        command -v pacman >/dev/null || die "pacman is not installed"
        msg "updating the Arch base"
        # --noconfirm because nothing can answer a prompt here, and --needed so
        # a re-run after a partial failure does not rebuild what already landed.
        pacman -Syu --noconfirm --needed --noprogressbar
        msg "packages up to date"
        ;;
    *)
        die "usage: liteai-update update"
        ;;
esac
