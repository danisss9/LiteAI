[Unit]
Description=Expand the LiteAI root filesystem to fill the media
DefaultDependencies=no
Conflicts=shutdown.target
After=systemd-remount-fs.service
Before=systemd-user-sessions.service systemd-fsck-root.service shutdown.target
ConditionPathExists=!/var/lib/liteai/rootfs-expanded

[Service]
Type=oneshot
ExecStart=/usr/local/bin/liteai-expand-rootfs
RemainAfterExit=yes
StandardOutput=journal+console

[Install]
WantedBy=sysinit.target
